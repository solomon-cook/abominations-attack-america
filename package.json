{
  "name": "abominations-attack-america",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "catalogue:verify": "node scripts/generate-component-rules-catalogue.mjs",
    "traceability:verify": "node scripts/verify-rules-traceability.mjs",
    "source-audit:verify": "node scripts/verify-source-audit.mjs",
    "release-blockers:verify": "tsx scripts/verify-release-blockers.ts",
    "contracts:verify": "tsx scripts/verify-contract-fixtures.ts",
    "docs:verify": "node scripts/verify-markdown-links.mjs",
    "board-review:generate": "tsx scripts/generate-board-review-table.ts",
    "board-overlay:generate": "tsx scripts/generate-board-comparison-overlay.ts",
    "board-assets:verify": "node scripts/verify-board-assets.mjs",
    "board-review:verify": "npm run board-review:generate && git diff --exit-code -- docs/board-review-table.md",
    "verify": "npm run catalogue:verify && npm run traceability:verify && npm run source-audit:verify && npm run release-blockers:verify && npm run board-review:verify && npm run board-assets:verify && npm run contracts:verify && npm run docs:verify && npm test && npm run typecheck && npm run build",
    "dev": "npm --workspace @abominations/web run dev",
    "dev:api": "npm --workspace @abominations/api run dev",
    "build": "npm --workspace @abominations/web run build",
    "build:api": "npm --workspace @abominations/api run build",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm --workspace @abominations/web run typecheck",
    "typecheck:api": "npm --workspace @abominations/api run typecheck",
    "test": "npm --workspace @abominations/game-engine run test && npm --workspace @abominations/api run test",
    "prisma:generate": "npm --workspace @abominations/api run prisma:generate",
    "prisma:validate": "prisma validate --config apps/api/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "prisma:push": "npm --workspace @abominations/api run prisma:push"
  }
}
