# API runtime
PORT=8787
ALLOWED_ORIGIN=https://staging.example.invalid

# Pooled application connection for Prisma/Postgres. For Prisma Postgres, use
# its pooled.db.prisma.io URL here.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional direct connection for Prisma CLI migrations and PostgreSQL
# LISTEN/NOTIFY. Required with a Prisma Postgres pooled DATABASE_URL.
DIRECT_URL=postgresql://user:password@host:5432/database

# Optional HTTPS error-alert webhook; sends category/count metadata only.
ERROR_ALERT_URL=

# Web build/runtime API origin (Vite exposes VITE_* values to the browser).
VITE_API_URL=https://api.staging.example.invalid
WEB_APP_URL=https://staging.example.invalid

# Optional transactional email delivery endpoint. It receives JSON {to, subject, text}.
ACCOUNT_EMAIL_DELIVERY_URL=
ACCOUNT_EMAIL_DELIVERY_TOKEN=
