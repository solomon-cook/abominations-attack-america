# API runtime
PORT=8787
ALLOWED_ORIGIN=https://staging.example.invalid

# Set only for a configured Prisma/Postgres environment.
DATABASE_URL=postgresql://user:password@host:5432/database

# Web build/runtime API origin (Vite exposes VITE_* values to the browser).
VITE_API_URL=https://api.staging.example.invalid
WEB_APP_URL=https://staging.example.invalid

# Optional transactional email delivery endpoint. It receives JSON {to, subject, text}.
ACCOUNT_EMAIL_DELIVERY_URL=
ACCOUNT_EMAIL_DELIVERY_TOKEN=
