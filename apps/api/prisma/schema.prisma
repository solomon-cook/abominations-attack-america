generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABANDONED
  EXPIRED
}

enum RoomPrivacy {
  PRIVATE
  PUBLIC
}

enum ParticipantRole {
  PLAYER
  SPECTATOR
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model GameRoom {
  id           String       @id @default(cuid())
  code         String       @unique
  status       RoomStatus   @default(WAITING)
  privacy      RoomPrivacy  @default(PRIVATE)
  isTest       Boolean      @default(false)
  maxPlayers   Int          @default(4)
  version      Int          @default(0)
  state        Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastActivityAt DateTime   @default(now())
  completedAt  DateTime?
  participants Participant[]
  events       GameEvent[]
  receipts     CommandReceipt[]
  result       GameResult?
  playerStats  Json               @default("[]")
  websocketTickets WebSocketTicket[]
  matchStats   PlayerMatchStat[]
}

model UserAccount {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  username        String              @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        AccountSession[]
  tokens          AccountToken[]
  participants    Participant[]
  matchStats      PlayerMatchStat[]
}

model AccountSession {
  id        String      @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  @@index([userId, expiresAt])
}

model AccountToken {
  id         String              @id @default(cuid())
  userId     String
  user       UserAccount         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String              @unique
  purpose    AccountTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  @@index([userId, purpose, expiresAt])
}

model WebSocketTicket {
  id            String      @id @default(cuid())
  roomId        String
  room          GameRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantTokenHash String
  tokenHash     String      @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  @@index([roomId, participantId, expiresAt])
}

model Participant {
  id           String            @id @default(cuid())
  roomId       String
  room         GameRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName  String
  role         ParticipantRole
  playerIndex  Int?
  tokenHash    String            @unique
  sessionExpiresAt DateTime
  connectedAt  DateTime?
  connectionId String?
  ready        Boolean           @default(false)
  userId       String?
  user         UserAccount?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  disconnectedAt DateTime?
  botControlled Boolean         @default(false)
  botAssisted  Boolean          @default(false)
  createdAt    DateTime          @default(now())
  websocketTickets WebSocketTicket[]
  matchStats   PlayerMatchStat[]
  @@unique([roomId, role, playerIndex])
  @@unique([roomId, userId])
  @@index([roomId, role])
  @@index([userId, role])
  @@index([botControlled, disconnectedAt])
}

model GameEvent {
  id          String   @id @default(cuid())
  roomId      String
  room        GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  version     Int
  actorId     String
  type        String
  controlSource String   @default("human")
  payload     Json
  createdAt   DateTime @default(now())
  @@unique([roomId, version])
  @@index([roomId, createdAt])
}

model CommandReceipt {
  id         String   @id @default(cuid())
  roomId     String
  room       GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actionId   String
  actorId    String
  version    Int
  eventType  String
  createdAt  DateTime @default(now())
  @@unique([roomId, actionId])
  @@index([roomId, version])
}

model GameResult {
  id          String   @id @default(cuid())
  roomId      String   @unique
  room        GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winnerId    String?
  winnerName  String?
  summary     Json
  createdAt   DateTime @default(now())
}

model PlayerMatchStat {
  id             String      @id @default(cuid())
  roomId         String
  room           GameRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  userId         String
  user           UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerIndex    Int
  username       String
  outcome        String
  monsterId      String
  monsterName    String
  branch         String
  stompedTiles   Int         @default(0)
  damageTaken    Int         @default(0)
  healthGained   Int         @default(0)
  luckTotal      Float       @default(0)
  luckRolls      Int         @default(0)
  botAssisted    Boolean     @default(false)
  rounds         Int
  completedAt    DateTime    @default(now())
  @@unique([roomId, participantId])
  @@index([userId, completedAt])
  @@index([outcome, completedAt])
}
