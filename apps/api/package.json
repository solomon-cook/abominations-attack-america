{
  "name": "@abominations/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:push": "prisma db push --config prisma.config.ts"
  },
  "dependencies": {
    "@abominations/game-engine": "*",
    "@abominations/shared": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "latest",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "latest"
  }
}
